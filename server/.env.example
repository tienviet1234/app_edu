# ─── Required ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# MongoDB Atlas connection string (or local: mongodb://localhost:27017/lms)
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/lms?retryWrites=true&w=majority

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_random_hex_chars
JWT_REFRESH_SECRET=replace_with_different_64_random_hex_chars

# ─── CORS ────────────────────────────────────────────────────────────────────
# The URL where the frontend is deployed (no trailing slash)
CLIENT_ORIGIN=https://your-app.vercel.app

# ─── Admin registration ───────────────────────────────────────────────────────
# Anyone who registers with this code gets admin role — keep it secret
ADMIN_INVITE_CODE=change_this_secret_code

# ─── Web Push (VAPID) — generate once with web-push library ──────────────────
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@your-domain.com

# ─── Email (SMTP) — optional, logs to console when empty ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=no-reply@your-domain.com

# ─── Optional tuning ─────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRES_MIN=10
