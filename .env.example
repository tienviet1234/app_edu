# Local development
VITE_API_URL=http://localhost:4000/api

# Local network (phone/tablet access) — replace with your computer's IP
# VITE_API_URL=http://192.168.1.11:4000/api

# Production (Railway) — set this in Vercel dashboard → Settings → Environment Variables
# VITE_API_URL=https://your-backend.railway.app/api
